# OpenAI-compatible LLM
LLM_API_KEY=sk-REPLACE-ME
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.4
LLM_TIMEOUT_S=60

# Translation glossary
LLM_GLOSSARY_ENABLED=true
LLM_GLOSSARY_MODEL=
LLM_GLOSSARY_MAX_TERMS=32
LLM_GLOSSARY_MAX_ZH_CANDIDATES=32
LLM_GLOSSARY_MAX_INPUT_CHARS=24000
LLM_GLOSSARY_MAX_TOKENS=5000
LLM_GLOSSARY_MAX_RETRIES=2

# Browser used to render PressReader open Shadow DOM
BROWSER_USER_DATA_PATH=
BROWSER_HEADLESS=false

# PressReader issue entry base (the crawler appends /YYYYMMDD/textview)
FT_PREVIEW_BASE_URL=https://ft.pressreader.com/v99c
# FT subscription entry used to activate the PressReader ePaper entitlement
FT_EPAPER_ACCESS_URL=https://www.ft.com/todaysnewspaper/edition/uk
PRESSREADER_LOAD_TIMEOUT_S=30
CRAWL_DELAY_MIN_S=2
CRAWL_DELAY_MAX_S=5

# LLM concurrency
LLM_COMPILE_WORKERS=2
LLM_MAX_PENDING=4

# Optional output overrides
OUTPUT_ROOT=
DATABASE_JS_PATH=
INDEX_HTML_PATH=
INDEX_HTML_TEMPLATE=
ARTICLE_MD_DIR=
